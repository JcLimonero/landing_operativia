{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Orvia Landing.dc.html"
    },
    {
      "source": "/agente-whatsapp",
      "destination": "/Orvia Agente WhatsApp.dc.html"
    },
    {
      "source": "/mentoria-ia",
      "destination": "/Orvia Mentoria IA.dc.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/condiciones",
      "destination": "/condiciones.html"
    },
    {
      "source": "/automotriz",
      "destination": "/automotriz.html"
    },
    {
      "source": "/refaccionarias",
      "destination": "/refaccionarias.html"
    },
    {
      "source": "/precios",
      "destination": "/precios.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "operativai.com.mx"
        }
      ],
      "destination": "https://www.orvia.tech/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.operativai.com.mx"
        }
      ],
      "destination": "https://www.orvia.tech/$1",
      "permanent": true
    },
    {
      "source": "/Orvia(.*)Landing.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Orvia(.*)Agente(.*)WhatsApp.dc.html",
      "destination": "/agente-whatsapp",
      "permanent": true
    },
    {
      "source": "/Orvia(.*)Mentoria(.*)IA.dc.html",
      "destination": "/mentoria-ia",
      "permanent": true
    },
    {
      "source": "/OperativAI(.*)Landing.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/OperativAI(.*)Agente(.*)WhatsApp.dc.html",
      "destination": "/agente-whatsapp",
      "permanent": true
    },
    {
      "source": "/OperativAI(.*)Mentoria(.*)IA.dc.html",
      "destination": "/mentoria-ia",
      "permanent": true
    },
    {
      "source": "/privacidad.html",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/condiciones.html",
      "destination": "/condiciones",
      "permanent": true
    },
    {
      "source": "/automotriz.html",
      "destination": "/automotriz",
      "permanent": true
    },
    {
      "source": "/refaccionarias.html",
      "destination": "/refaccionarias",
      "permanent": true
    },
    {
      "source": "/precios.html",
      "destination": "/precios",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
