{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/OperativAI Landing.dc.html"
    },
    {
      "source": "/agente-whatsapp",
      "destination": "/OperativAI Agente WhatsApp.dc.html"
    },
    {
      "source": "/mentoria-ia",
      "destination": "/OperativAI Mentoria IA.dc.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    }
  ],
  "redirects": [
    {
      "source": "/OperativAI Landing.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/OperativAI Agente WhatsApp.dc.html",
      "destination": "/agente-whatsapp",
      "permanent": true
    },
    {
      "source": "/OperativAI Mentoria IA.dc.html",
      "destination": "/mentoria-ia",
      "permanent": true
    },
    {
      "source": "/privacidad.html",
      "destination": "/privacidad",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
